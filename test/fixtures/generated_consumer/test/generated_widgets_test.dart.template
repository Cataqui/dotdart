import 'package:dotdart_generated_consumer_fixture/gen/icons.g.dart';
import 'package:dotdart_generated_consumer_fixture/gen/images.g.dart';
import 'package:dotdart_generated_consumer_fixture/gen/lotties.g.dart';
import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';

void main() {
  group('dotdart generated consumer', () {
    setUp(() {
      imageCache
        ..clear()
        ..clearLiveImages();
    });

    testWidgets('when generated vector and image accessors render together, it should paint without errors', (
      tester,
    ) async {
      await tester.pumpWidget(
        MaterialApp(
          home: Column(
            children: [
              $Icons.fixtureIcon(width: 24),
              $Icons.lottie(width: 40, progress: 0.5),
              $Icons.photo(width: 24),
              $Lotties.fixtureAnimation(
                width: 40,
                progress: 0.5,
                clip: false,
                delay: Duration.zero,
                duration: const Duration(milliseconds: 500),
                playback: LottiePlayback.once,
              ),
              $Lotties.cataquiJobCardsCarousel(
                width: 120,
                progress: 0.5,
                overrides: const CataquiJobCardsCarouselOverrides(
                  jobCard01TextJobTitleText: 'Custom title',
                  jobCard02TextJobTitleText: 'Another title',
                  jobCard01TextPayTextColor: Colors.green,
                ),
              ),
              $Images.landscape(width: 80),
              $Images.portrait(height: 80),
              $Images.animated(width: 40),
            ],
          ),
        ),
      );
      await tester.pumpAndSettle();

      expect(tester.takeException(), isNull);
    });

    testWidgets('when a landscape image receives width only, it should preserve its two-to-one aspect ratio', (
      tester,
    ) async {
      await tester.pumpWidget(MaterialApp(home: $Images.landscape(width: 80)));

      final image = tester.widget<Image>(find.byType(Image));
      expect((image.width, image.height), equals((80, 40)));
    });

    testWidgets('when a portrait image receives height only, it should preserve its one-to-two aspect ratio', (
      tester,
    ) async {
      await tester.pumpWidget(MaterialApp(home: $Images.portrait(height: 80)));

      final image = tester.widget<Image>(find.byType(Image));
      expect((image.width, image.height), equals((40, 80)));
    });

    testWidgets('when different asset types share one folder, it should expose them from one namespace', (
      tester,
    ) async {
      await tester.pumpWidget(
        MaterialApp(
          home: Column(
            children: [
              $Icons.fixtureIcon(width: 24),
              $Icons.lottie(width: 40, progress: 0.5),
              $Icons.photo(width: 24),
            ],
          ),
        ),
      );
      await tester.pumpAndSettle();

      expect(tester.takeException(), isNull);
    });

    testWidgets('when precaching without dimensions, it should remove the widget-default entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precacheLandscape(context));
      await tester.pump();

      expect(await $ImagesCache.removeLandscape(context), isTrue);
    });

    testWidgets('when removing a displayed image, it should preserve its live entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(
            builder: (value) {
              context = value;
              return $Images.landscape();
            },
          ),
        ),
      );
      await tester.pumpAndSettle();

      final image = tester.widget<Image>(find.byType(Image));
      final configuration = createLocalImageConfiguration(context);
      final key = await image.image.obtainKey(configuration);
      final removed = await $ImagesCache.removeLandscape(context);
      final status = imageCache.statusForKey(key);

      expect((removed, status.live, status.keepAlive), equals((true, true, false)));
    });

    testWidgets('when precaching an image by width, it should remove the derived-size entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precacheLandscape(context, width: 80));
      await tester.pump();

      expect(await $ImagesCache.removeLandscape(context, width: 80), isTrue);
    });

    testWidgets('when precaching an image by height, it should remove the derived-size entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precachePortrait(context, height: 80));
      await tester.pump();

      expect(await $ImagesCache.removePortrait(context, height: 80), isTrue);
    });

    testWidgets('when removing a different image size, it should preserve the matching cached entry', (tester) async {
      late BuildContext context;
      await tester.pumpWidget(
        MaterialApp(
          home: Builder(builder: (value) => SizedBox(key: ValueKey(context = value))),
        ),
      );

      await tester.runAsync(() => $ImagesCache.precacheLandscape(context, width: 80));
      await tester.pump();
      final removedDifferentSize = await $ImagesCache.removeLandscape(context, width: 40);
      final removedMatchingSize = await $ImagesCache.removeLandscape(context, width: 80);

      expect((removedDifferentSize, removedMatchingSize), equals((false, true)));
    });
  });
}
